# 文本文件使用LF行尾
*.html text eol=lf
*.css text eol=lf
*.js text eol=lf
*.json text eol=lf
*.txt text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf

# 二进制文件不转换
*.jpg binary
*.jpeg binary
*.png binary
*.gif binary
*.svg binary
*.ico binary
*.woff binary
*.woff2 binary
*.ttf binary
*.otf binary
*.eot binary
*.mp3 binary
*.mp4 binary
*.webm binary
*.ogg binary
*.wav binary
*.zip binary
*.rar binary
*.tar binary
*.gz binary
*.7z binary

# Docker相关文件
Dockerfile text eol=lf

# Git配置文件
.gitignore text eol=lf
.gitattributes text eol=lf